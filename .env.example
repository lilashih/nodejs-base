## 應用程式
APP_MODE=debug
APP_HOST=127.0.0.1
APP_PORT=3000
APP_TRUST_PROXY=loopback

## 資料庫：將 DB_CLIENT 設為 mysql 或 sqlite
DB_CLIENT=sqlite

## MySQL 模式
# DB_CLIENT=mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=nodejs_base

## Logger
LOG_LEVEL=debug
## 是否啟用獨立的 HTTP access log
LOG_ENABLE_ACCESS_LOG=true
## 設為 0 表示永久保留；大於 0 表示保留天數
LOG_RETENTION_DAYS=0

## CORS，多個來源以逗號分隔
CORS_ORIGINS=http://localhost:3000

## JWT，請務必替換為長度至少 32 字元的隨機字串
JWT_SECRET=replace-this-with-a-secure-random-secret
JWT_EXPIRES_IN=1h
JWT_ISSUER=nodejs-base
JWT_AUDIENCE=nodejs-base-api
## Cookie Session：正式 HTTPS 部署請設為 true
# COOKIE_SECURE=true
