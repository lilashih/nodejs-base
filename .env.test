APP_MODE=test
APP_HOST=127.0.0.1
APP_PORT=3001
APP_TRUST_PROXY=false
APP_FRONTEND_PATH=test/frontend/app

DB_CLIENT=sqlite
SQLITE_FILE=test/storage/database/database.sqlite

LOG_LEVEL=error
LOG_ENABLE_ACCESS_LOG=false
LOG_RETENTION_DAYS=0

CORS_ORIGINS=http://localhost:3000

JWT_SECRET=test-only-secret-with-at-least-32-characters
JWT_EXPIRES_IN=1h
JWT_ISSUER=nodejs-base
JWT_AUDIENCE=nodejs-base-api
