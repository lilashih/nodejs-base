{
  "name": "nodejs-base",
  "version": "1.0.0",
  "description": "可重複使用的 Node.js、Express 與 MySQL／SQLite API 基礎專案",
  "main": "src/app.js",
  "scripts": {
    "start": "pm2 delete ecosystem.config.js && pm2 start ecosystem.config.js",
    "dev": "pnpm build:frontend && (pm2 delete ecosystem.config.js || echo PM2 尚未啟動) && pm2 start ecosystem.config.js --watch && pnpm dev:frontend",
    "build:frontend": "pnpm --dir frontend build",
    "dev:frontend": "pnpm --dir frontend dev",
    "start:node": "node --env-file=.env src/app.js",
    "stop": "pm2 stop ecosystem.config.js",
    "test": "node --env-file=.env.test --env-file-if-exists=.env.test.local ./node_modules/jest/bin/jest.js --runInBand",
    "test:unit": "node --env-file=.env.test --env-file-if-exists=.env.test.local ./node_modules/jest/bin/jest.js --runInBand test/unit/",
    "test:coverage": "node --env-file=.env.test --env-file-if-exists=.env.test.local ./node_modules/jest/bin/jest.js --runInBand --coverage",
    "check": "node scripts/checkSyntax.js",
    "migrate": "node --env-file=.env scripts/migrate.js up",
    "migrate:rollback": "node --env-file=.env scripts/migrate.js rollback",
    "migrate:fresh": "node --env-file=.env scripts/migrate.js fresh",
    "migrate:unlock": "node --env-file=.env scripts/migrate.js unlock",
    "migrate:create": "node scripts/createMigration.js",
    "build:bun": "node scripts/buildBun.js",
    "build:bun:windows": "node scripts/buildBun.js --target=windows",
    "build:bun:linux": "node scripts/buildBun.js --target=linux"
  },
  "keywords": [
    "nodejs",
    "express",
    "mysql",
    "sqlite",
    "rest-api"
  ],
  "author": "",
  "license": "ISC",
  "_moduleAliases": {
    "@src": "./src"
  },
  "jest": {
    "moduleNameMapper": {
      "^@src/(.*)$": "<rootDir>/src/$1"
    },
    "testEnvironment": "node",
    "clearMocks": true,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/app.js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.3.0",
    "module-alias": "^2.2.3",
    "mysql2": "^3.14.4",
    "pm2": "^7.0.4",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "jest": "^30.1.3",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "packageManager": "pnpm@10.15.1"
}
